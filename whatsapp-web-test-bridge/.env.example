# WhatsApp Web test bridge config.
# Copy to .env on a new machine:
#   cp .env.example .env

# Local bot endpoint. The packaged start script will start this server if it is
# not already responding.
BOT_URL=http://127.0.0.1:3000/webhook
HOST=127.0.0.1
PORT=3000

# Demo tenant. Use beauty_demo for the salon bot.
WA_BRIDGE_BUSINESS_ID=beauty_demo

# Polling interval for Safari WhatsApp Web.
WA_BRIDGE_POLL_MS=2500

# Draft into WhatsApp Web composer. Set false to only print replies to logs.
WA_BRIDGE_DRAFT_REPLIES=true

# Auto-click Send after drafting. Default: true (the bot auto-sends replies on
# real WhatsApp chats). Set false if you want the bot to draft into the
# composer and stop, letting you review and press Send manually.
WA_BRIDGE_SEND_REPLIES=true

# For staff-review items, send a customer-facing handoff/next-step message.
WA_BRIDGE_SEND_HELD_DRAFTS=true

# Normally false so a restart does not re-process the latest visible message.
WA_BRIDGE_REPLY_LATEST_ON_START=false

# When the bot hands a chat to staff for these intents, pause further bot
# replies in that WhatsApp chat while staff is handling it. The bridge auto-
# resumes after staff replies and the customer acknowledges or asks a new
# substantive question. TTL is a fallback expiry.
WA_BRIDGE_HANDOFF_PAUSE=true
WA_BRIDGE_HANDOFF_PAUSE_TTL_HOURS=24
WA_BRIDGE_HANDOFF_PAUSE_INTENTS=booking,reschedule,complaint,sensitive_health,human_request,payment,order_status

# Claude credentials. Keep these in your local .env only; never commit
# credentials. The packaged bot tries ANTHROPIC_AUTH_TOKEN first, then
# CLAUDE_CODE_OAUTH_TOKEN if the proxy request fails, then ANTHROPIC_API_KEY,
# then OPENAI_OAUTH_TOKEN below.
#
# Get CLAUDE_CODE_OAUTH_TOKEN with `claude setup-token` (requires Pro/Max/
# Enterprise). Get ANTHROPIC_API_KEY from the Anthropic Console. Some proxy
# providers use ANTHROPIC_BASE_URL plus ANTHROPIC_AUTH_TOKEN instead.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Optional overrides per call site (default to CLAUDE_MODEL when unset).
CLAUDE_DRAFT_MODEL=
CLAUDE_INTENT_MODEL=

# OpenAI fallback. Used when no Claude credential above is set. For an offline
# demo only, set ALLOW_LOCAL_DEMO_LLM=true explicitly.
OPENAI_OAUTH_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
ALLOW_LOCAL_DEMO_LLM=false

# ambiguous = only ask the LLM to classify low-confidence messages.
# always = ask the LLM for intent/confidence on every non-blocked message,
# while still preserving deterministic high-risk safety classifications.
# LLM_INTENT_MODE applies to whichever provider is active; OPENAI_INTENT_MODE
# is kept as a fallback name for older setups.
LLM_INTENT_MODE=always
OPENAI_INTENT_MODE=always
