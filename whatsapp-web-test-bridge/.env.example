# WhatsApp Web test bridge config.
# Copy to .env on a new machine:
#   cp .env.example .env

# Local bot endpoint. The packaged start script will start this server if it is
# not already responding.
BOT_URL=http://127.0.0.1:3000/webhook
HOST=127.0.0.1
PORT=3000

# Demo tenant. Use beauty_demo for the salon bot.
WA_BRIDGE_BUSINESS_ID=beauty_demo

# Polling interval for Safari WhatsApp Web.
WA_BRIDGE_POLL_MS=2500

# Draft into WhatsApp Web composer. Set false to only print replies to logs.
WA_BRIDGE_DRAFT_REPLIES=true

# Auto-click Send after drafting.
# Safer fresh-clone default is false. Set true only on a test account/chat.
WA_BRIDGE_SEND_REPLIES=false

# For staff-review items, send a customer-facing handoff/next-step message.
WA_BRIDGE_SEND_HELD_DRAFTS=true

# Normally false so a restart does not re-process the latest visible message.
WA_BRIDGE_REPLY_LATEST_ON_START=false

# When the bot hands a chat to staff for these intents, pause further bot
# replies in that WhatsApp chat while staff is handling it. The bridge auto-
# resumes after staff replies and the customer acknowledges or asks a new
# substantive question. TTL is a fallback expiry.
WA_BRIDGE_HANDOFF_PAUSE=true
WA_BRIDGE_HANDOFF_PAUSE_TTL_HOURS=24
WA_BRIDGE_HANDOFF_PAUSE_INTENTS=booking,reschedule,complaint,sensitive_health,human_request,payment,order_status
