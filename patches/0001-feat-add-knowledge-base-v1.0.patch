+  {
+    name: "ig shop: stock + shipping",
+    businessId: "igshop_demo",
+    input: "呢件有冇現貨？包唔包順豐？",
+    expectBestMatchAnyOf: ["igshop_stock", "igshop_shipping"],
+    expectGap: false
+  },
+  {
+    name: "education: P3 English",
+    businessId: "edu_demo",
+    input: "我個小朋友P3，英文好差，有咩班？",
+    expectBestMatchId: "edu_p3_english",
+    expectGap: false
+  },
+  {
