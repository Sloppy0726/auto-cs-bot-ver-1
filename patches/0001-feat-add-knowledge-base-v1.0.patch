+    input: "做完會唔會即刻見效？幾錢？有冇副作用？",
+    expectBestMatchId: "beauty_pricing_facial",
+    expectGap: false,
+    expectHandoff: false,
+    expectBackendBound: false,
+    expectLanguage: "zh-HK"
+  },
+  {
+    name: "beauty: opening hours in mixed",
+    businessId: "beauty_demo",
+    input: "Causeway Bay店今晚幾點收工？",
