# Copy to .env for local auth settings.
CODEX_LLM_AUTH_MODE=oauth
CODEX_ACCESS_TOKEN=

# Claude API-key mode for WhatsApp staff-review/handoff drafts.
# Set WA_LLM_ADAPTER=claude-api when using these keys.
# WA_LLM_ADAPTER=claude-api
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
CLAUDE_API_MAX_TOKENS=700
# CLAUDE_API_MODEL=claude-sonnet-4-6

# Claude subscription OAuth mode for local smoke testing.
# Easiest path: paste the token from `claude setup-token` here. Requires a
# Claude Pro / Max / Enterprise subscription. Routes direct to api.anthropic.com,
# so leave ANTHROPIC_BASE_URL unset for this mode.
# CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_OAUTH_MODEL=claude-opus-4-6
CLAUDE_OAUTH_MAX_TOKENS=700
# Alternate path (internal): Hermes credential-pool file with refresh-token support.
# CLAUDE_OAUTH_AUTH_PATH=/Users/book/.hermes/auth.json

# Codex CLI OAuth smoke-test mode.
CODEX_CLI_PATH=/Applications/Codex.app/Contents/Resources/codex
CODEX_LLM_MODEL=gpt-5.5
CODEX_LLM_TIMEOUT_MS=90000
CODEX_LOGIN_TIMEOUT_MS=30000
# CODEX_HOME=/Users/book/.codex

# --- Owner command console ---
# Phone numbers that get owner privileges in WhatsApp/Telegram (comma-separated).
# The bot recognizes these senders and lets them run toolkit commands with short
# Chinese keywords, a numbered menu ("選單"), or natural language. Leave empty to
# disable (everyone stays on the normal customer-support flow).
OWNER_PHONES=

# Channels on which the owner fast-path may run (comma-separated). Owner identity
# is a phone number, so it is only trustworthy where the operator verifies the
# sender. Defaults to whatsapp only; the website channel is never trusted because
# its sessionId is client-chosen. Override only if you wire another verified channel.
# OWNER_CHANNELS=whatsapp

# --- Admin / debug endpoints ---
# Token required for /admin/* and /debug/fake-db. In production these endpoints
# are blocked entirely if this is unset; in local dev they are open.
# ADMIN_TOKEN=
# Set to true ONLY when a trusted reverse proxy sets X-Forwarded-For; otherwise
# the rate limiter uses the real socket address so the header can't be spoofed.
# TRUST_PROXY=false

# --- Small-Business Toolkit (MCP) providers ---
# Each tool is blocked (auth_required) until its provider's credentials are set.
# Fill in only the providers you use. Run `npm run mcp:smb`, or call the
# smb-onboard tool to see which providers are connected.
# Stripe (invoice-chase):
STRIPE_API_KEY=
# QuickBooks (finance/briefings): access token + company realm id
QUICKBOOKS_ACCESS_TOKEN=
QUICKBOOKS_REALM_ID=
# Square (CRM, price-check, sales-brief):
SQUARE_ACCESS_TOKEN=
# PayPal (payments; surfaced via smb-onboard): OAuth client credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Google Gmail/Calendar/Drive (lead-triage, complaints, campaigns, job posts):
GOOGLE_ACCESS_TOKEN=
# Canva (content-strategy, canva-creator):
CANVA_ACCESS_TOKEN=
# DocuSign (contract review): access token + account id
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_ACCOUNT_ID=
